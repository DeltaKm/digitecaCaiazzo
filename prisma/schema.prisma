// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String     @default("user") // "user" o "admin"
  accounts      Account[]
  sessions      Session[]
  documents     Document[] // Documenti caricati dall'admin
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Document {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String?
  type         String   @default("documento-testuale") // Tipo: documento-testuale, immagine, foto, video, audio
  category     String   // Categoria principale (archivi, audio, biblioteca, immagini, kere, materiali, radici, regesti, video)
  subcategory  String   // Sottocategoria specifica per ogni categoria
  period       String?  // Periodo storico
  identifier   String   @unique // ID univoco per il documento (es: "DGT-SHS53788")
  
  // Metadati aggiuntivi
  author       String   @default("") // Autore del documento
  attribution  String   @default("") // Attribuzione del documento
  license      String   @default("tutti-i-diritti-riservati") // Licenza: tutti-i-diritti-riservati, creative-commons, dominio-pubblico
  ccType       String   @default("") // Tipo Creative Commons: cc-by, cc-by-sa, cc-by-nc (solo se license = creative-commons)
  location     String   @default("") // Luogo di origine/produzione
  collocationLocation String @default("") // Luogo di collocazione/conservazione attuale
  century      String   @default("") // Secolo
  materials    String   @default("") // Materiali utilizzati
  dimensions   String   @default("") // Dimensioni
  conditions   String   @default("") // Condizioni di conservazione
  provenance   String   @default("") // Provenienza
  
  
  thumbnail    String   // URL thumbnail
  manifestUrl  String   // URL al manifest IIIF
  images       Image[]  // Immagini ad alta risoluzione
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  published    Boolean  @default(true) // Visibile pubblicamente
}

model Image {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  documentId    String   @db.ObjectId
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  url           String   // URL immagine ad alta risoluzione
  width         Int
  height        Int
  format        String   // es: "jpg", "tiff", "png"
  order         Int      @default(0) // Ordine nell'insieme
  pageNumber    Int?     @map("page_number") // Numero di pagina (opzionale, per documenti multi-pagina)
  label         String?  // Nome personalizzato della pagina/canvas (es: "Copertina", "Pagina 1r", etc.)
  transcription String?  // Trascrizione completa del testo nella pagina
  keywords      String?  // Parole chiave separate da virgola
  notes         String?  // Note aggiuntive
  annotations   String   @default("[]") // Annotazioni IIIF in formato JSON array
  createdAt     DateTime @default(now())
}

model Category {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId    String   @unique // ID leggibile (es: "archivi", "audio", "biblioteca")
  name          String   // Nome visualizzato della categoria
  subcategories String[] // Array di sottocategorie
  order         Int      @default(0) // Ordine di visualizzazione
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DocumentType {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  typeId    String   @unique // ID leggibile (es: "documento-testuale", "immagine", "foto")
  name      String   // Nome visualizzato del tipo
  order     Int      @default(0) // Ordine di visualizzazione
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
